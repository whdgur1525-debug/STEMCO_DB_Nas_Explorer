<Window x:Class="Aoi.NasExplorer.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Synapse NAS Explorer · 검사 결과 조회" Width="1500" Height="940" MinWidth="1100" MinHeight="720" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="35"/></Grid.RowDefinitions>
  <Border Background="#12223C"><Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center"><TextBlock Text="SYNAPSE  /  NAS EXPLORER" Foreground="White" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="검사 결과를 한곳에서 찾고, 확인하고, 추출하세요" Foreground="#B0C2DC" FontSize="12" Margin="0,5,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="ConnectionLabel" Text="연결 전 · 읽기 전용" Foreground="#CAD8EB" Margin="0,0,16,0"/><Button Content="NAS 연결" Click="Connect_Click" Background="#2563EB" Foreground="White" BorderThickness="0"/><Button Content="예제 보기" Click="Demo_Click"/></StackPanel>
  </Grid></Border>
  <Border Grid.Row="1" Background="White" Padding="17,10"><DockPanel>
   <Button DockPanel.Dock="Right" Content="취소" Click="Cancel_Click"/><Button DockPanel.Dock="Right" Content="검색 / 새로고침" Click="Search_Click" Background="#2563EB" Foreground="White"/>
   <ComboBox x:Name="ScopeBox" Width="205" ToolTip="검색할 DB 범위" DisplayMemberPath="Label"/>
   <ComboBox x:Name="LevelBox" Width="100" SelectedIndex="1"><ComboBoxItem Content="모델"/><ComboBoxItem Content="LOT"/><ComboBoxItem Content="레이어"/><ComboBoxItem Content="검사 이력"/><ComboBoxItem Content="불량"/></ComboBox>
   <TextBox x:Name="SearchText" MinWidth="160" ToolTip="모델명 또는 LOT명에 포함된 문자열" KeyDown="SearchText_KeyDown"/>
  </DockPanel></Border>
  <Border Grid.Row="2" Background="White" BorderBrush="#E1E7EF" BorderThickness="0,0,0,1" Padding="22,0,22,9"><Expander Header="상세 검색 · 기간 / 장비 / 판정 / 측정값" Foreground="#51627D">
   <WrapPanel Margin="0,10,0,0">
    <StackPanel><TextBlock Text="검사 시작일"/><DatePicker x:Name="FromDate" Width="143" Margin="3"/></StackPanel>
    <StackPanel><TextBlock Text="검사 종료일"/><DatePicker x:Name="ToDate" Width="143" Margin="3"/></StackPanel>
    <StackPanel><TextBlock Text="모델 (정확히)"/><TextBox x:Name="ModelText" Width="130"/></StackPanel><StackPanel><TextBlock Text="LOT (정확히)"/><TextBox x:Name="LotText" Width="130"/></StackPanel>
    <StackPanel><TextBlock Text="레이어"/><TextBox x:Name="LayerText" Width="90"/></StackPanel><StackPanel><TextBlock Text="장비"/><TextBox x:Name="MachineText" Width="100"/></StackPanel>
    <StackPanel><TextBlock Text="패널"/><TextBox x:Name="PanelText" Width="65"/></StackPanel><StackPanel><TextBlock Text="PC"/><TextBox x:Name="PcText" Width="55"/></StackPanel>
    <StackPanel><TextBlock Text="AOI 코드"/><TextBox x:Name="DefectText" Width="75"/></StackPanel><StackPanel><TextBlock Text="VMS 코드"/><TextBox x:Name="VmsText" Width="75"/></StackPanel>
    <StackPanel><TextBlock Text="AI 코드"/><TextBox x:Name="AiText" Width="65"/></StackPanel><StackPanel><TextBlock Text="원인 코드"/><TextBox x:Name="CauseCodeText" Width="75"/></StackPanel>
    <StackPanel><TextBlock Text="원인 문자열"/><TextBox x:Name="CauseText" Width="160"/></StackPanel>
    <StackPanel><TextBlock Text="크기 최소"/><TextBox x:Name="MinSizeText" Width="75"/></StackPanel><StackPanel><TextBlock Text="크기 최대"/><TextBox x:Name="MaxSizeText" Width="75"/></StackPanel>
    <StackPanel><TextBlock Text="VMS 판정"/><ComboBox x:Name="StateBox" Width="115" SelectedIndex="0"><ComboBoxItem Content="전체"/><ComboBoxItem Content="미검토 (0)"/><ComboBoxItem Content="불량 (1)"/><ComboBoxItem Content="통과 (2)"/></ComboBox></StackPanel>
    <StackPanel><TextBlock Text="이미지"/><ComboBox x:Name="ImageFilterBox" Width="105" SelectedIndex="0"><ComboBoxItem Content="전체"/><ComboBoxItem Content="있음"/><ComboBoxItem Content="없음"/></ComboBox></StackPanel>
    <CheckBox x:Name="LatestCheck" Content="DB·레이어·장비·패널·PC별 최신만"/><Button Content="조건 초기화" Click="Clear_Click"/>
   </WrapPanel>
  </Expander></Border>
  <Grid Grid.Row="3" Margin="16,12,16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="230" MinWidth="150"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*" MinWidth="350"/><ColumnDefinition Width="7"/><ColumnDefinition Width="390" MinWidth="260"/></Grid.ColumnDefinitions>
   <Border Background="White" CornerRadius="8"><DockPanel Margin="12"><StackPanel DockPanel.Dock="Top"><TextBlock Text="데이터 탐색" FontSize="16" FontWeight="SemiBold" Margin="4,4,4,8"/><StackPanel Orientation="Horizontal"><Button Content="뒤로" Click="Back_Click"/><Button Content="즐겨찾기" Click="Favorite_Click" Padding="8,5"/></StackPanel><TextBlock Text="폴더 펼치기 · 두 번 클릭으로 열기" Foreground="#7B8BA3" FontSize="10" Margin="4,8"/></StackPanel><TreeView x:Name="Navigation" BorderThickness="0" SelectedItemChanged="Navigation_Selected" TreeViewItem.Expanded="Navigation_Expanded"/></DockPanel></Border>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="Transparent"/>
   <Border Grid.Column="2" Background="White" CornerRadius="8"><DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="14,10"><TextBlock x:Name="Breadcrumb" Text="NAS 연결 또는 예제 보기를 선택하세요" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><WrapPanel Margin="-3,7,0,0"><Button Content="CSV · 검색 결과 전체" Click="ExportCsv_Click"/><Button Content="선택 이미지" Click="ExportImages_Click"/><Button Content="전체 이미지" Click="ExportAllImages_Click"/><Button Content="ERT 보기" Click="PreviewErt_Click"/><Button Content="ERT 저장" Click="ExportErt_Click"/><Button Content="원본 JSON" Click="ExportJson_Click"/></WrapPanel><TextBlock x:Name="Notice" Text="원본 DB는 변경하지 않습니다" Foreground="#7B8BA3" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="12,8"><Button x:Name="MoreButton" Content="다음 250개 읽기" Click="More_Click" DockPanel.Dock="Right" IsEnabled="False"/><TextBlock x:Name="CountLabel" Text="0개" Foreground="#51627D"/></DockPanel>
    <DataGrid x:Name="Results" AutoGenerateColumns="False" SelectionChanged="Results_SelectionChanged" MouseDoubleClick="Results_DoubleClick" ClipboardCopyMode="IncludeHeader"/>
   </DockPanel></Border>
   <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Center" Background="Transparent"/>
   <Border Grid.Column="4" Background="White" CornerRadius="8"><DockPanel Margin="14,10">
    <TextBlock DockPanel.Dock="Top" Text="이미지와 상세 정보" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <TabControl BorderThickness="0"><TabItem Header="이미지"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Background="#101C2E" CornerRadius="6" ClipToBounds="True"><ScrollViewer x:Name="ImageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="Image_MouseWheel"><Grid><Image x:Name="DefectImage" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor" HorizontalAlignment="Center" VerticalAlignment="Center"><Image.LayoutTransform><ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/></Image.LayoutTransform></Image><TextBlock x:Name="ImagePlaceholder" Text="불량을 선택하면 이미지를 표시합니다" Foreground="#A4B7D1" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="20"/></Grid></ScrollViewer></Border>
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="−" Click="ZoomOut_Click"/><Button Content="맞춤" Click="Fit_Click"/><Button Content="1:1" Click="Actual_Click"/><Button Content="＋" Click="ZoomIn_Click"/><Button Content="저장" Click="SaveImage_Click"/></StackPanel>
      <TextBlock Grid.Row="2" x:Name="ImageInfo" Text="휠로 확대 · 스크롤로 이동 · 방향키로 목록 이동" Foreground="#7B8BA3" FontSize="11" TextWrapping="Wrap" Margin="0,6"/>
    </Grid></TabItem>
    <TabItem Header="전체 필드"><DockPanel><TextBlock DockPanel.Dock="Top" x:Name="DetailSource" Foreground="#51627D" TextWrapping="Wrap" Margin="5,8"/><DataGrid x:Name="Details" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="항목" Binding="{Binding Field}" Width="165"/><DataGridTextColumn Header="저장된 값" Binding="{Binding Value}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
    <TabItem Header="썸네일"><DockPanel><Button DockPanel.Dock="Top" Content="현재 목록의 선택 행 (최대 24개)" Click="Thumbnails_Click"/><ScrollViewer VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="ThumbnailPanel"/></ScrollViewer></DockPanel></TabItem>
    <TabItem Header="작업 기록"><TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0"/></TabItem>
    </TabControl>
   </DockPanel></Border>
  </Grid>
  <DockPanel Grid.Row="4" Margin="22,0"><TextBlock DockPanel.Dock="Right" Text="읽기 전용  ·  v0.1" Foreground="#7B8BA3"/><TextBlock x:Name="Status" Text="준비됨" Foreground="#51627D" TextTrimming="CharacterEllipsis"/></DockPanel>
 </Grid>
</Window>
