<Window x:Class="Aoi.NasExplorer.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Synapse NAS Explorer · 검사 결과 조회" Width="1500" Height="940" MinWidth="1100" MinHeight="720" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
 <Grid Background="#F4F6FA">
  <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="35"/></Grid.RowDefinitions>
  <Border Background="#12223C"><Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center"><TextBlock Text="SYNAPSE  /  NAS EXPLORER" Foreground="White" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="검사 결과를 한곳에서 찾고, 확인하고, 추출하세요" Foreground="#B0C2DC" FontSize="12" Margin="0,5,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="ConnectionLabel" Text="연결 전 · 읽기 전용" Foreground="#CAD8EB" Margin="0,0,16,0"/><Button Content="NAS 연결" Click="Connect_Click" Background="#2563EB" Foreground="White" BorderThickness="0"/><Button Content="예제 보기" Click="Demo_Click"/></StackPanel>
  </Grid></Border>
  <Border Grid.Row="1" Background="White" Padding="17,10"><StackPanel><DockPanel>
   <Button DockPanel.Dock="Right" x:Name="CancelButton" Content="취소" Click="Cancel_Click"/><Button DockPanel.Dock="Right" x:Name="RefreshButton" Content="새로고침" Click="Refresh_Click"/><Button DockPanel.Dock="Right" x:Name="SearchButton" Content="검색" Click="Search_Click" Background="#2563EB" Foreground="White"/>
   <ComboBox x:Name="ScopeBox" Width="205" ToolTip="검색할 DB 범위" DisplayMemberPath="Label"/>
   <ComboBox x:Name="LevelBox" Width="100" SelectedIndex="1" Visibility="Collapsed"><ComboBoxItem Content="모델"/><ComboBoxItem Content="LOT"/><ComboBoxItem Content="레이어"/><ComboBoxItem Content="검사 이력"/><ComboBoxItem Content="불량"/></ComboBox>
   <ComboBox x:Name="SearchTargetBox" Width="110" SelectedIndex="0"><ComboBoxItem Content="LOT 검색"/><ComboBoxItem Content="모델 검색"/><ComboBoxItem Content="모델 + LOT"/></ComboBox>
   <TextBox x:Name="SearchText" MinWidth="160" ToolTip="이름의 일부만 입력해도 됩니다. 예: agsd. 새 검색은 이전 폴더 제한을 해제합니다." KeyDown="SearchText_KeyDown"/>
  </DockPanel><TextBlock Text="LOT 이름의 일부 입력 → 검색 · LOT 선택 → 불량 바로 보기 · 위 경로를 눌러 이전 검색으로 복귀" Foreground="#7B8BA3" FontSize="11" Margin="4,5,0,0"/></StackPanel></Border>
  <Border Grid.Row="2" Background="White" BorderBrush="#E1E7EF" BorderThickness="0,0,0,1" Padding="22,0,22,9"><Expander x:Name="DetailSearchExpander" Header="상세 검색 · 기간 / 장비 / 판정 / 측정값" Foreground="#51627D">
   <StackPanel><ScrollViewer x:Name="DetailFilterScroll" MaxHeight="85" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><WrapPanel Margin="0,10,0,0">
    <StackPanel><TextBlock Text="검사 시작일"/><DatePicker x:Name="FromDate" Width="143" Margin="3"/></StackPanel>
    <StackPanel><TextBlock Text="검사 종료일"/><DatePicker x:Name="ToDate" Width="143" Margin="3"/></StackPanel>
    <StackPanel><TextBlock Text="모델 (정확히)"/><TextBox x:Name="ModelText" Width="130"/></StackPanel><StackPanel><TextBlock Text="LOT (정확히)"/><TextBox x:Name="LotText" Width="130"/></StackPanel>
    <StackPanel><TextBlock Text="Layer 전체 이름 (정확히)"/><TextBox x:Name="LayerText" Width="240"/></StackPanel><StackPanel><TextBlock Text="장비"/><TextBox x:Name="MachineText" Width="100"/></StackPanel>
    <StackPanel><TextBlock Text="패널"/><TextBox x:Name="PanelText" Width="65"/></StackPanel><StackPanel Visibility="Collapsed"><TextBox x:Name="PcText" Width="55"/></StackPanel>
    <StackPanel><TextBlock Text="AOI 코드"/><TextBox x:Name="DefectText" Width="75"/></StackPanel><StackPanel><TextBlock Text="VMS 코드"/><TextBox x:Name="VmsText" Width="75"/></StackPanel>
    <StackPanel><TextBlock Text="AI 코드"/><TextBox x:Name="AiText" Width="65"/></StackPanel><StackPanel><TextBlock Text="원인 코드"/><TextBox x:Name="CauseCodeText" Width="75"/></StackPanel>
    <StackPanel><TextBlock Text="원인 문자열"/><TextBox x:Name="CauseText" Width="160"/></StackPanel>
    <StackPanel><TextBlock Text="크기 최소"/><TextBox x:Name="MinSizeText" Width="75"/></StackPanel><StackPanel><TextBlock Text="크기 최대"/><TextBox x:Name="MaxSizeText" Width="75"/></StackPanel>
    <StackPanel><TextBlock Text="VMS 판정"/><ComboBox x:Name="StateBox" Width="115" SelectedIndex="0"><ComboBoxItem Content="전체"/><ComboBoxItem Content="미검토 (0)"/><ComboBoxItem Content="불량 (1)"/><ComboBoxItem Content="통과 (2)"/></ComboBox></StackPanel>
    <StackPanel><TextBlock Text="이미지"/><ComboBox x:Name="ImageFilterBox" Width="105" SelectedIndex="0"><ComboBoxItem Content="전체"/><ComboBoxItem Content="있음"/><ComboBoxItem Content="없음"/></ComboBox></StackPanel>
    <CheckBox x:Name="LatestCheck" Content="레이어·장비·패널별 최신 기록만"/></WrapPanel></ScrollViewer><WrapPanel><Button Content="현재 범위에 조건 적용" Click="Filter_Click"/><Button Content="조건 초기화" Click="Clear_Click"/>
   </WrapPanel></StackPanel>
  </Expander></Border>
  <Grid Grid.Row="3" Margin="16,12,16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="230" MinWidth="150"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*" MinWidth="350"/><ColumnDefinition Width="7"/><ColumnDefinition Width="390" MinWidth="260"/></Grid.ColumnDefinitions>
   <Border Background="White" CornerRadius="8"><DockPanel Margin="10"><StackPanel DockPanel.Dock="Top"><DockPanel><Button DockPanel.Dock="Right" x:Name="DatabasesButton" Content="↻" ToolTip="새로고침 · 새 DB와 현재 목록을 함께 갱신합니다" Click="Refresh_Click" Padding="7,3"/><TextBlock Text="데이터 탐색" FontSize="16" FontWeight="SemiBold" Margin="4"/></DockPanel><WrapPanel><Button x:Name="BackButton" Content="← 뒤로" Click="Back_Click"/><Button x:Name="ForwardButton" Content="앞으로 →" Click="Forward_Click"/></WrapPanel><TextBlock Text="모델 → LotID → Layer → 패널" Foreground="#7B8BA3" FontSize="10" Margin="4"/></StackPanel><TreeView x:Name="Navigation" BorderThickness="0" SelectedItemChanged="Navigation_Selected" TreeViewItem.Expanded="Navigation_Expanded"/></DockPanel></Border>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="Transparent"/>
   <Border Grid.Column="2" Background="White" CornerRadius="8"><DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="10,5">
     <TextBlock x:Name="Breadcrumb" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="NAS 연결 또는 예제 보기를 선택하세요" Foreground="#51627D" FontSize="11" TextWrapping="Wrap"/><ScrollViewer x:Name="ScopeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><WrapPanel x:Name="PathPanel"/></ScrollViewer><WrapPanel><Button x:Name="OpenInspectionsButton" Content="패널 목록 열기" Click="OpenInspections_Click" Padding="8,3"/><Button x:Name="OpenDefectsButton" Content="불량 목록 열기" Click="OpenDefects_Click" Padding="8,3"/></WrapPanel>
     <TextBlock x:Name="SummaryLabel" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="LOT 이름을 입력하고 검색하세요 · 일부 이름도 검색할 수 있습니다" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5"/>
     <TextBlock x:Name="ActiveFilterLabel" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="#51627D" FontSize="11" TextWrapping="Wrap"/>
<WrapPanel><Button x:Name="ReviewChecksButton" Click="ReviewChecks_Click" Padding="5,2" ToolTip="체크한 항목 확인 · 이전 표시 구간의 항목도 확인하고 개별 해제합니다"><TextBlock x:Name="CheckedLabel" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="150"/></Button><Button x:Name="OpenOutputButton" Content="저장 폴더" Click="OpenOutput_Click" Padding="8,4"/><Button x:Name="BundleButton" Padding="8,4" Content="↓ 내보내기…" Click="Bundle_Click" Background="#2563EB" Foreground="White"/></WrapPanel>
     <WrapPanel><TextBlock Text="자동 갱신" VerticalAlignment="Center"/><ComboBox x:Name="AutoRefreshBox" Width="75" SelectedIndex="0" SelectionChanged="AutoRefresh_Changed"><ComboBoxItem Content="꺼짐"/><ComboBoxItem Content="1분"/><ComboBoxItem Content="5분"/></ComboBox><TextBlock x:Name="RefreshLabel" VerticalAlignment="Center" Foreground="#51627D" TextWrapping="Wrap"/></WrapPanel>
     <StackPanel Visibility="Collapsed"><Button x:Name="CsvButton" Click="ExportCsv_Click"/><Button x:Name="SelectedImagesButton"/><Button x:Name="AllImagesButton"/><Button x:Name="ErtPreviewButton"/><Button x:Name="ErtButton"/><Button x:Name="JsonButton"/></StackPanel>
     <TextBlock x:Name="Notice" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Text="원본 DB는 변경하지 않습니다" Foreground="#7B8BA3" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
    </StackPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="12,8"><Button x:Name="MoreButton" Content="다음 250개 읽기" Click="More_Click" DockPanel.Dock="Right" IsEnabled="False"/><TextBlock x:Name="CountLabel" Text="0개" Foreground="#51627D"/></DockPanel>
    <Expander x:Name="SummaryExpander" DockPanel.Dock="Bottom" Header="LOT · 패널별 전체 건수" Margin="10,3" IsExpanded="False"><DockPanel><Button Visibility="Collapsed" DockPanel.Dock="Bottom" x:Name="SummaryCsvButton" Content="현재 집계 표 CSV 저장" Click="SummaryCsv_Click"/><TabControl x:Name="SummaryTabs"><TabItem Header="패널별 (더블클릭: 불량 열기)"><DataGrid x:Name="PanelSummary" AutoGenerateColumns="False" MaxHeight="180" MouseDoubleClick="PanelSummary_DoubleClick"/></TabItem><TabItem Header="LOT별"><DataGrid x:Name="LotSummary" AutoGenerateColumns="False" MaxHeight="180"/></TabItem></TabControl></DockPanel></Expander>
    <DataGrid x:Name="Results" FrozenColumnCount="1" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutoGenerateColumns="False" SelectionChanged="Results_SelectionChanged" MouseDoubleClick="Results_DoubleClick" ContextMenuOpening="Results_ContextMenuOpening" ClipboardCopyMode="IncludeHeader"><DataGrid.ContextMenu><ContextMenu><MenuItem Tag="checked-images" Header="체크한 불량 이미지 저장…" Click="ExportCheckedImages_Click"/><Separator/><MenuItem Tag="json" Header="선택 원본 JSON 저장…" Click="ExportJson_Click"/><MenuItem Tag="csv" Header="현재 검색 전체 원본 CSV 저장…" Click="ExportCsv_Click"/><MenuItem Tag="ert" Header="선택 검사 ERT 미리보기" Click="PreviewErt_Click"/></ContextMenu></DataGrid.ContextMenu></DataGrid>
   </DockPanel></Border>
   <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Center" Background="Transparent"/>
   <Border Grid.Column="4" Background="White" CornerRadius="8"><DockPanel Margin="14,10">
    <TextBlock DockPanel.Dock="Top" Text="이미지와 상세 정보" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <TabControl BorderThickness="0"><TabItem Header="이미지"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Background="#101C2E" CornerRadius="6" ClipToBounds="True" ContextMenuOpening="Image_ContextMenuOpening"><Border.ContextMenu><ContextMenu><MenuItem Tag="image" Header="현재 이미지만 저장…" Click="SaveCurrentImage_Click"/><MenuItem Tag="panel" Header="현재 패널 전체 내보내기…" Click="Bundle_Click"/></ContextMenu></Border.ContextMenu><ScrollViewer x:Name="ImageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="Image_MouseWheel"><Grid><Image x:Name="DefectImage" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor" HorizontalAlignment="Center" VerticalAlignment="Center"><Image.LayoutTransform><ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/></Image.LayoutTransform></Image><TextBlock x:Name="ImagePlaceholder" Text="불량을 선택하면 이미지를 표시합니다" Foreground="#A4B7D1" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="20"/></Grid></ScrollViewer></Border>
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="−" Click="ZoomOut_Click"/><Button Content="맞춤" Click="Fit_Click"/><Button Content="1:1" Click="Actual_Click"/><Button Content="＋" Click="ZoomIn_Click"/><Button x:Name="SaveImageButton" Visibility="Collapsed" Content="저장" Click="SaveImage_Click"/></StackPanel>
      <TextBlock Grid.Row="2" x:Name="ImageInfo" Text="휠로 확대 · 스크롤로 이동 · 방향키로 목록 이동" Foreground="#7B8BA3" FontSize="11" TextWrapping="Wrap" Margin="0,6"/>
    </Grid></TabItem>
    <TabItem Header="전체 필드"><DockPanel><TextBlock DockPanel.Dock="Top" x:Name="DetailSource" Foreground="#51627D" TextWrapping="Wrap" Margin="5,8"/><DataGrid x:Name="Details" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="항목" Binding="{Binding Field}" Width="165"/><DataGridTextColumn Header="저장된 값" Binding="{Binding Value}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
    <TabItem Header="썸네일"><DockPanel><Button DockPanel.Dock="Top" Content="현재 목록의 선택 행 (최대 24개)" Click="Thumbnails_Click"/><ScrollViewer VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="ThumbnailPanel"/></ScrollViewer></DockPanel></TabItem>
    <TabItem Header="작업 기록"><TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0"/></TabItem>
    </TabControl>
   </DockPanel></Border>
  </Grid>
  <DockPanel Grid.Row="4" Margin="22,0"><TextBlock x:Name="VersionLabel" DockPanel.Dock="Right" Text="읽기 전용" Foreground="#7B8BA3"/><TextBlock x:Name="Status" Text="준비됨" Foreground="#51627D" TextTrimming="CharacterEllipsis"/></DockPanel>
  <Border x:Name="IdleOverlay" Grid.RowSpan="5" Panel.ZIndex="100" Background="#F4F6FA" Visibility="Collapsed"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560"><TextBlock Text="조회가 일시 정지되었습니다" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="10분 동안 사용하지 않아 자동 갱신을 끄고 조회 연결을 정리했습니다. 다시 조회하면 계속 볼 수 있습니다." FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="0,16"/><Button x:Name="ResumeButton" Content="↻ 다시 조회" Click="Resume_Click" Background="#2563EB" Foreground="White" HorizontalAlignment="Center" Padding="30,12"/></StackPanel></Border>
 </Grid>
</Window>
